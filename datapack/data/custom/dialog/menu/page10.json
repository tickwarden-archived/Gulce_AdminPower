{
  "type": "minecraft:multi_action",
  "title": {
    "text": "AdminPower — Dünya Yönetimi [10/16]",
    "color": "gold",
    "bold": true,
    "italic": false
  },
  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": "🌐 WB 100 blok",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:wb_small"
      }
    },
    {
      "label": "🌐 WB 1000 blok",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:wb_medium"
      }
    },
    {
      "label": "🌐 WB 10000 blok",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:wb_large"
      }
    },
    {
      "label": "🌐 WB Sıfırla (max)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:wb_reset"
      }
    },
    {
      "label": "🏠 Spawn'ı Buraya Al",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:set_spawn_here"
      }
    },
    {
      "label": "💀 Tüm Mobları Temizle",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:kill_all_mobs_world"
      }
    },
    {
      "label": "🔲 Fill Komutu →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "🔲 Fill Komutu",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "x1",
              "label": "X1",
              "max_length": 16,
              "initial": "~-5"
            },
            {
              "type": "minecraft:text",
              "key": "y1",
              "label": "Y1",
              "max_length": 16,
              "initial": "~-5"
            },
            {
              "type": "minecraft:text",
              "key": "z1",
              "label": "Z1",
              "max_length": 16,
              "initial": "~-5"
            },
            {
              "type": "minecraft:text",
              "key": "x2",
              "label": "X2",
              "max_length": 16,
              "initial": "~5"
            },
            {
              "type": "minecraft:text",
              "key": "y2",
              "label": "Y2",
              "max_length": 16,
              "initial": "~5"
            },
            {
              "type": "minecraft:text",
              "key": "z2",
              "label": "Z2",
              "max_length": 16,
              "initial": "~5"
            },
            {
              "type": "minecraft:text",
              "key": "block",
              "label": "🧱 Blok",
              "max_length": 64,
              "initial": "minecraft:air"
            },
            {
              "type": "minecraft:single_option",
              "key": "mode",
              "label": "⚙ Mod",
              "options": [
                {
                  "id": "replace",
                  "display": "replace"
                },
                {
                  "id": "destroy",
                  "display": "destroy"
                },
                {
                  "id": "keep",
                  "display": "keep"
                },
                {
                  "id": "outline",
                  "display": "outline"
                },
                {
                  "id": "hollow",
                  "display": "hollow"
                }
              ]
            }
          ],
          "actions": [
            {
              "label": "✅ Doldur",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/fill $(x1) $(y1) $(z1) $(x2) $(y2) $(z2) $(block) $(mode)"
              }
            },
            {
              "label": "◀ Geri",
              "action": {
                "type": "minecraft:show_dialog",
                "dialog": "custom:menu/page10"
              }
            }
          ]
        }
      }
    },
    {
      "label": "◀ Önceki",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "custom:menu/page9"
      }
    },
    {
      "label": "Sonraki ▶",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "custom:menu/page11"
      }
    }
  ]
}