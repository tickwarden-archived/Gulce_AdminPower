{
  "type": "minecraft:multi_action",
  "title": {
    "text": "AdminPower — Toplu İşlemler [14/16]",
    "color": "gold",
    "bold": true,
    "italic": false
  },
  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": "❤ Herkesi İyileştir  (30sn CD)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:heal_all"
      }
    },
    {
      "label": "🍖 Herkesi Doyur  (30sn CD)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:feed_all"
      }
    },
    {
      "label": "🏠 Herkesi Spawn'a Işınla  (60sn CD)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:tp_spawn_all"
      }
    },
    {
      "label": "🔱 Netherit Ver  (5dk CD)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:give_netherite"
      }
    },
    {
      "label": "🔥 Ateş Topu Değneği Ver",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:items/give_fireball_wand"
      }
    },
    {
      "label": "📣 Title Gönder →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "📣 Title Gönder",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "msg",
              "label": "📝 Mesaj",
              "max_length": 128,
              "initial": "Merhaba!"
            },
            {
              "type": "minecraft:single_option",
              "key": "type",
              "label": "Tür",
              "options": [
                {
                  "id": "title",
                  "display": "Başlık"
                },
                {
                  "id": "subtitle",
                  "display": "Alt Başlık"
                },
                {
                  "id": "actionbar",
                  "display": "Actionbar"
                }
              ]
            },
            {
              "type": "minecraft:single_option",
              "key": "color",
              "label": "🎨 Renk",
              "options": [
                {
                  "id": "gold",
                  "display": "Altın"
                },
                {
                  "id": "red",
                  "display": "Kırmızı"
                },
                {
                  "id": "green",
                  "display": "Yeşil"
                },
                {
                  "id": "aqua",
                  "display": "Açık Mavi"
                },
                {
                  "id": "white",
                  "display": "Beyaz"
                },
                {
                  "id": "yellow",
                  "display": "Sarı"
                }
              ]
            },
            {
              "type": "minecraft:single_option",
              "key": "target",
              "label": "🎯 Hedef",
              "options": [
                {
                  "id": "@a",
                  "display": "Herkes"
                },
                {
                  "id": "@s",
                  "display": "Kendim"
                },
                {
                  "id": "@p",
                  "display": "En Yakın"
                }
              ]
            }
          ],
          "actions": [
            {
              "label": "✅ Gönder",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/title $(target) $(type) {text:\"$(msg)\",color:\"$(color)\",bold:true}"
              }
            },
            {
              "label": "◀ Geri",
              "action": {
                "type": "minecraft:show_dialog",
                "dialog": "custom:menu/page14"
              }
            }
          ]
        }
      }
    },
    {
      "label": "◀ Önceki",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "custom:menu/page13"
      }
    },
    {
      "label": "Sonraki ▶",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "custom:menu/page15"
      }
    }
  ]
}