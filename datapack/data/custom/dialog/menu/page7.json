        "type": "minecraft:run_command",
        "command": "/function custom:lp/page7"
      }
    },
    {
      "label": "🔐 LP Kullanıcı Yönet →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "🔐 LP Kullanıcı Yönet",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "user",
              "label": "👤 Kullanıcı",
              "max_length": 64,
              "initial": "@s"
            },
            {
              "type": "minecraft:single_option",
              "key": "group",
              "label": "👥 Grup",
              "options": [
                {
                  "id": "default",
                  "display": "default"
                },
                {
                  "id": "vip",
                  "display": "vip"
                },
                {
                  "id": "mod",
                  "display": "mod"
                },
                {
                  "id": "admin",
                  "display": "admin"
                },
                {
                  "id": "owner",
                  "display": "owner"
                }
              ]
            },
            {
              "type": "minecraft:single_option",
              "key": "action",
              "label": "⚡ İşlem",
              "options": [
                {
                  "id": "parent set",
                  "display": "Gruba Ata"
                },
                {
                  "id": "parent add",
                  "display": "Gruba Ekle"
                },
                {
                  "id": "parent remove",
                  "display": "Gruptan Çıkar"
                },
                {
                  "id": "parent clear",
                  "display": "Grupları Temizle"
                }
              ]
            }
          ],
          "actions": [
            {
              "label": "✅ Uygula",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/lp user $(user) $(action) $(group)"
              }
            },
            {
              "label": "◀ Geri",
              "action": {
                "type": "minecraft:show_dialog",
                "dialog": "custom:menu/page7"
              }
            }
          ]
        }
      }
    },
    {
      "label": "◀ Önceki",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "custom:menu/page6"
      }
    },
    {
      "label": "Sonraki ▶",
      "action": {
