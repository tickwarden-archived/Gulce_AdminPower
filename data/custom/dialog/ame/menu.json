{
  "type": "minecraft:multi_action",
  "title": {
    "text": "⚙ AME Araçları",
    "color": "aqua",
    "bold": true,
    "italic": false
  },
  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": "📋 Log Görüntüle",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:ame/log"
      }
    },
    {
      "label": "🗑 Log Temizle",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:ame/log/clear"
      }
    },
    {
      "label": "⏱ CD Durumu",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:ame/cd/overview"
      }
    },
    {
      "label": "⏩ CD Sıfırla  (AME epoch)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:ame/cd/reset"
      }
    },
    {
      "label": "⚙ Config  (CD süreleri)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:ame/config"
      }
    },
    {
      "label": "ℹ Durum  (AME entegrasyon)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:ame/status"
      }
    },
    {
      "label": "🔒 Yetki Sync",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:ame/perm/sync"
      }
    },
    {
      "label": "⚠ AdminPower'ı Kaldır",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "custom:uninstall/menu"
      }
    },
    {
      "label": "◀ Geri",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "custom:menu/page16"
      }
    }
  ]
}