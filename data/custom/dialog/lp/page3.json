{
  "type": "minecraft:multi_action",
  "title": {
    "text": "LuckPerms — Gruplar [3/7]",
    "color": "gold",
    "bold": true,
    "italic": false
  },
  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": "📋 lp listgroups",
      "action": {
        "type": "minecraft:run_command",
        "command": "/lp listgroups"
      }
    },
    {
      "label": "➕ Grup Oluştur →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "lp creategroup",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "group",
              "label": "🏷 Grup Adı",
              "max_length": 64,
              "initial": "vip"
            }
          ],
          "actions": [
            {
              "label": "✅ Uygula",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/lp creategroup $(group)"
              }
            },
            {
              "label": "◀ Geri",
              "action": {
                "type": "minecraft:show_dialog",
                "dialog": "custom:lp/page3"
              }
            }
          ]
        }
      }
    },
    {
      "label": "🗑 Grup Sil →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "lp deletegroup",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "group",
              "label": "🏷 Grup Adı",
