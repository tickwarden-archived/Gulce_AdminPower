{
  "type": "minecraft:multi_action",
  "title": {
    "text": "LuckPerms — Kullanıcı [2/7]",
    "color": "gold",
    "bold": true,
    "italic": false
  },
  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": "ℹ Kullanıcı Bilgisi →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "lp user info",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "player",
              "label": "👤 Oyuncu Adı",
              "max_length": 64,
              "initial": "@s"
            }
          ],
          "actions": [
            {
              "label": "✅ Uygula",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/lp user $(player) info"
              }
            },
            {
              "label": "◀ Geri",
              "action": {
                "type": "minecraft:show_dialog",
                "dialog": "custom:lp/page2"
              }
            }
          ]
        }
      }
    },
    {
