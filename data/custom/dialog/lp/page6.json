      "label": "➕ Kullanıcıya Parent Ekle →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "user parent add",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "player",
              "label": "👤 Oyuncu",
              "max_length": 64,
              "initial": "@s"
            },
            {
              "type": "minecraft:text",
              "key": "group",
              "label": "🏷 Grup",
              "max_length": 64,
              "initial": "vip"
            }
          ],
          "actions": [
            {
              "label": "✅ Uygula",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/lp user $(player) parent add $(group)"
              }
            },
            {
              "label": "◀ Geri",
