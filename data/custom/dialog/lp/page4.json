          "type": "minecraft:multi_action",
          "title": "lp createtrack",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "track",
              "label": "🛤 Track Adı",
              "max_length": 64,
              "initial": "staff"
            }
          ],
          "actions": [
            {
              "label": "✅ Uygula",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/lp createtrack $(track)"
              }
            },
            {
              "label": "◀ Geri",
              "action": {
                "type": "minecraft:show_dialog",
                "dialog": "custom:lp/page4"
              }
            }
          ]
        }
      }
