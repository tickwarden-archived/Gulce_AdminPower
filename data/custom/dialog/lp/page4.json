    "bold": true,
    "italic": false
  },
  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": "📋 lp listtracks",
      "action": {
        "type": "minecraft:run_command",
        "command": "/lp listtracks"
      }
    },
    {
      "label": "➕ Track Oluştur →",
      "action": {
        "type": "minecraft:show_dialog",
