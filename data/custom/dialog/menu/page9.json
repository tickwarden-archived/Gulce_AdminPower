{
  "type": "minecraft:multi_action",
  "title": {
    "text": "AdminPower — Oyuncu Yönetimi [9/16]",
    "color": "gold",
    "bold": true,
    "italic": false
  },
  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": "🌀 En Yakına Işınlan  (10sn CD)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:tp_to_nearest"
      }
    },
    {
      "label": "🧲 En Yakını Çek  (10sn CD)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:summon_nearest"
      }
    },
    {
      "label": "🌀 Herkesi Yanına Çek  (60sn CD)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:tp_all_here"
      }
    },
    {
      "label": "👁 Oyuncuyu Işılt",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:highlight_player"
      }
    },
    {
      "label": "📋 Online Oyuncuları Listele",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:list_players"
      }
    },
    {
      "label": "🚀 Oyuncu Işınla →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "🚀 Oyuncu Işınla",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "from",
              "label": "🚹 Kaynak Oyuncu",
              "max_length": 64,
              "initial": "@s"
            },
            {
              "type": "minecraft:text",
              "key": "to",
              "label": "🎯 Hedef Oyuncu / Koordinat",
              "max_length": 64,
              "initial": "@p"
            }
          ],
          "actions": [
            {
              "label": "🚀 Işınla",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/execute as $(from) run tp @s $(to)"
              }
            },
            {
              "label": "◀ Geri",
              "action": {
                "type": "minecraft:show_dialog",
                "dialog": "custom:menu/page9"
              }
            }
          ]
        }
      }
    },
    {
      "label": "💀 Oyuncuyu Öldür →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "💀 Oyuncuyu Öldür",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:single_option",
              "key": "target",
              "label": "🎯 Hedef",
              "options": [
                {
                  "id": "@p",
                  "display": "En Yakın"
                },
                {
                  "id": "@r",
                  "display": "Rastgele"
                },
                {
                  "id": "@a",
                  "display": "Herkes"
                }
              ]
            }
          ],
          "actions": [
            {
              "label": "💀 Öldür",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/kill $(target)"
              }
            },
            {
              "label": "◀ Geri",
              "action": {
                "type": "minecraft:show_dialog",
                "dialog": "custom:menu/page9"
              }
            }
          ]
        }
      }
    },
    {
      "label": "👢 Oyuncuyu At →",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:multi_action",
          "title": "👢 Oyuncuyu At",
          "can_close_with_escape": true,
          "pause": false,
          "inputs": [
            {
              "type": "minecraft:text",
              "key": "player",
              "label": "👤 Oyuncu Adı",
              "max_length": 64,
              "initial": ""
            },
            {
              "type": "minecraft:text",
              "key": "reason",
              "label": "📝 Sebep",
              "max_length": 128,
              "initial": "Kural ihlali"
            }
          ],
          "actions": [
            {
              "label": "👢 At",
              "action": {
                "type": "minecraft:dynamic/run_command",
                "template": "/function custom:macros/player/kick {player:\"$(player)\",reason:\"$(reason)\"}"
              }
            },
            {
              "label": "◀ Geri",
              "action": {
                "type": "minecraft:show_dialog",
                "dialog": "custom:menu/page9"
              }
            }
          ]
        }
      }
    },
    {
      "label": "⚠ Uyar (En Yakın)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:exec/warn_player"
      }
    },
    {
      "label": "✅ Uyarı Sıfırla",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function custom:exec/warn_reset"
      }
    },
    {
      "label": "◀ Önceki",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "custom:menu/page8"
      }
    },
    {
      "label": "Sonraki ▶",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "custom:menu/page10"
      }
    }
  ]
}